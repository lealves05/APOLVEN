# Conexão Postgres (Supabase: use a "Session pooler" connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apolven
# Schema próprio do APOLVEN (pode dividir o banco com outro sistema)
DB_SCHEMA=apolven
# Segredo para assinar os tokens de login (valor longo e aleatório; obrigatório em produção)
JWT_SECRET=
# Chave do cofre de credenciais das seguradoras e do MFA (separada do JWT; não troque depois de usar)
APOLVEN_VAULT_KEY=
# Domínios do frontend autorizados (separe por vírgula)
CORS_ORIGIN=http://localhost:5173
PORT=3334
# Central da plataforma (Master). Sem estas variáveis nada é bloqueado.
PLATFORM_HUB_URL=
PLATFORM_SECRET=
# PLATFORM_PRODUCT=apolven
# MFA obrigatório para proprietário/administrador/financeiro (deixe vazio). "off" só em desenvolvimento.
# APOLVEN_MFA=off
# Conector interno de testes (NUNCA em produção)
# APOLVEN_TEST_ADAPTERS=1
