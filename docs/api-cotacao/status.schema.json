{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apolven.app/schemas/apolven-cotacao-1/status.json",
  "title": "APOLVEN — teste de conexão (GET {base}/v1/status)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato",
    "status"
  ],
  "properties": {
    "contrato": {
      "const": "apolven-cotacao/1"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "indisponivel"
      ]
    },
    "seguradora": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "ambiente": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "producao",
        "homologacao",
        null
      ]
    },
    "ramos": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "enum": [
          "auto",
          "frota",
          "residencial",
          "condominio",
          "empresarial",
          "vida",
          "vida_grupo",
          "saude",
          "odonto",
          "viagem",
          "rc",
          "do_cyber",
          "equipamentos",
          "rural",
          "transportes",
          "garantia",
          "fianca",
          "previdencia"
        ]
      },
      "description": "Ramos que esta API cota (vazio = não informado)."
    }
  }
}
